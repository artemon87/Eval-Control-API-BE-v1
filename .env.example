APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bryte_evals
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173



GCS_SUGGESTION_BUCKET=evalhub-suggestions-dev
GCS_SUGGESTION_PREFIX=suggestions
SUGGESTION_IMAGE_MAX_FILES=3
SUGGESTION_IMAGE_MAX_BYTES=10485760

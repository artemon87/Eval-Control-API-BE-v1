{
  "script": "evalhub_read_api.js",
  "tags": {
    "team": "RAG_Agents_Platform",
    "service": "EvalHub",
    "endpoint": "eval_api"
  },
  "tests": {
    "smoke": {
      "vus": 1,
      "duration": "1m",
      "thresholds": {
        "http_req_duration": [
          "p(95)<10000"
        ],
        "http_req_failed": [
          "rate<0.01"
        ],
        "checks": [
          "rate>0.99"
        ],
        "evalhub_bad_payloads": [
          "count==0"
        ]
      }
    },
    "average_load": {
      "stages": [
        {
          "duration": "30s",
          "target": 5
        },
        {
          "duration": "1m",
          "target": 15
        },
        {
          "duration": "30s",
          "target": 0
        }
      ],
      "thresholds": {
        "http_req_duration": [
          "p(95)<20000"
        ],
        "http_req_failed": [
          "rate<0.01"
        ],
        "checks": [
          "rate>0.95"
        ]
      }
    },
    "stress": {
      "stages": [
        {
          "duration": "2m",
          "target": 30
        },
        {
          "duration": "5m",
          "target": 30
        },
        {
          "duration": "1m",
          "target": 0
        }
      ],
      "thresholds": {
        "http_req_duration": [
          "p(95)<30000"
        ],
        "http_req_failed": [
          "rate<0.05"
        ],
        "checks": [
          "rate>0.90"
        ]
      }
    },
    "spike": {
      "stages": [
        {
          "duration": "30s",
          "target": 100
        },
        {
          "duration": "30s",
          "target": 100
        },
        {
          "duration": "30s",
          "target": 0
        }
      ],
      "thresholds": {
        "http_req_duration": [
          "p(95)<45000"
        ],
        "http_req_failed": [
          "rate<0.1"
        ]
      }
    }
  }
}
